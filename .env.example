# Porta del PC che fa da server in rete (le altre postazioni aprono il browser qui)
PORT=3000

# Indirizzo pubblico per i QR. In officina usa l'IP o il nome del PC, es. http://192.168.1.20:3000
# Se vuoto, Siderio usa l'host della richiesta.
PUBLIC_URL=

# Cartella dati (database SQLite + file CAD). Resta sul disco, non in un container.
DATA_DIR=./data
